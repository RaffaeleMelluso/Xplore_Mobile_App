<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <!-- First-run page 1: a hot-air balloon drifting over the hills at dusk. -->
    <group android:name="scene">
        <clip-path android:pathData="M100,100m-88,0a88,88 0,1 0,176 0a88,88 0,1 0,-176 0" />
        <!-- Dusk sky: indigo above, warm sunset light on the horizon. -->
        <path android:pathData="M0,0h200v200h-200z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="0"
                    android:endX="0" android:endY="200"
                    android:startColor="#FF141A52"
                    android:centerColor="#FF6B2E78"
                    android:endColor="#FFF3A45E" />
            </aapt:attr>
        </path>
        <!-- Soft glow where the sun just went down. -->
        <path android:pathData="M0,50h200v150h-200z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="100" android:centerY="150" android:gradientRadius="95"
                    android:startColor="#80FFB35C"
                    android:endColor="#00FFB35C" />
            </aapt:attr>
        </path>
        <!-- Stars, in three brightness tiers. -->
        <path
            android:fillColor="#F2FFFFFF"
            android:pathData="M44,40m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0M28,74m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0M172,74m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0" />
        <path
            android:fillColor="#B3FFFFFF"
            android:pathData="M64,26m-1.7,0a1.7,1.7 0,1 0,3.4 0a1.7,1.7 0,1 0,-3.4 0M136,26m-1.7,0a1.7,1.7 0,1 0,3.4 0a1.7,1.7 0,1 0,-3.4 0M24,110m-1.7,0a1.7,1.7 0,1 0,3.4 0a1.7,1.7 0,1 0,-3.4 0M176,110m-1.7,0a1.7,1.7 0,1 0,3.4 0a1.7,1.7 0,1 0,-3.4 0" />
        <path
            android:fillColor="#73FFFFFF"
            android:pathData="M84,20m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0M116,20m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0M52,58m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0M148,58m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0" />
        <path
            android:fillColor="#F2FFFFFF"
            android:pathData="M156,31L158.2,37.8L165,40L158.2,42.2L156,49L153.8,42.2L147,40L153.8,37.8Z" />
        <!-- Hill silhouettes against the glow. -->
        <path
            android:fillColor="#FF33265C"
            android:pathData="M0,152C48,132 96,130 136,140C166,147 184,148 200,146L200,200L0,200Z" />
        <path
            android:fillColor="#FF16193C"
            android:pathData="M0,176C44,166 84,170 118,180C150,190 178,188 200,182L200,200L0,200Z" />
        <!-- Burner glow under the envelope. -->
        <path android:pathData="M82,80h36v36h-36z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="100" android:centerY="98" android:gradientRadius="18"
                    android:startColor="#99FFD37A"
                    android:endColor="#00FFD37A" />
            </aapt:attr>
        </path>
        <!-- Envelope, with the three gores that make a balloon read as one. -->
        <path android:pathData="M100,58m-32,0a32,36 0,1 0,64 0a32,36 0,1 0,-64 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="100" android:startY="22"
                    android:endX="100" android:endY="94"
                    android:startColor="#FFFFBE73"
                    android:endColor="#FFE4603A" />
            </aapt:attr>
        </path>
        <path
            android:fillColor="#66FFD9A0"
            android:pathData="M100,58m-10,0a10,33 0,1 0,20 0a10,33 0,1 0,-20 0" />
        <path
            android:fillColor="#4D7A2E1E"
            android:pathData="M81,58m-7,0a7,26 0,1 0,14 0a7,26 0,1 0,-14 0M119,58m-7,0a7,26 0,1 0,14 0a7,26 0,1 0,-14 0" />
        <!-- Ropes. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFE8C7A0"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M92,90L90,104M108,90L110,104" />
        <!-- Basket. -->
        <path
            android:fillColor="#FFC1784A"
            android:pathData="M92,104h16a4,4 0,0 1,4 4v10a4,4 0,0 1,-4 4h-16a4,4 0,0 1,-4 -4v-10a4,4 0,0 1,4 -4z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFE0A87A"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M91,108h18" />
    </group>
    <!-- Subtle rim: keeps the postcard readable on the dark theme too. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2"
        android:pathData="M100,100m-86,0a86,86 0,1 0,172 0a86,86 0,1 0,-172 0" />
</vector>
